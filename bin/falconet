#!/usr/bin/env bash
#
# falconet — turn a plain-language infrastructure request into a pull request
# carrying a real plan, and stop there.
#
# This is a dispatcher and nothing else. It resolves a verb to a script in
# libexec/falconet/ and hands over with exec, so the verb owns its own stdout,
# its own exit code, and its own argument parsing. Nothing is interpreted on
# the way through: a verb that prints one word prints one word, and this file
# is not in a position to add to it.
#
#   falconet <verb> [args]
#
# The six verbs are the stages of the pipeline (docs/adr/0003-the-cli-surface.md).
# They never call each other; they pass files through the handoff directory.
#
# `prompt` is a seventh, unlisted on purpose: it exists so the action wrappers
# can resolve a configurable prompt path without embedding heredocs in YAML.
# It is public in the sense that it works, not in the sense that it is
# vocabulary.
#
# Exit codes, uniform across every verb:
#   0  an outcome was determined (which outcome is on stdout, in one word)
#   1  refused mechanically, or a check failed
#   2  usage error — including -h/--help, because 0 would mean "ran, fine"

set -uo pipefail

VERBS="prepare commit push park validate assemble"
UNLISTED="prompt"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIBEXEC="$(dirname "$SCRIPT_DIR")/libexec/falconet"

usage() { # [complaint...]
  [ $# -eq 0 ] || printf 'falconet: %s\n\n' "$*" >&2
  cat >&2 <<'USAGE'
Usage: falconet <verb> [args]

  prepare   claim an eligible issue, open a branch, capture a baseline plan
  commit    read the agent's work off the tree and commit it through the guards
  push      get the branch onto the remote the moment a commit exists
  validate  validate and plan every configured stack, collecting failures
  park      put an issue into a terminal state and say so where it will be read
  assemble  build a pull-request body carrying the whole plan

Run `falconet <verb> -h` for a verb's own options.
USAGE
  exit 2
}

[ $# -ge 1 ] || usage "no verb given"

verb="$1"; shift

case "$verb" in
  -h|--help|help) usage ;;
esac

case " $VERBS $UNLISTED " in
  *" $verb "*) ;;
  *) usage "unknown verb '$verb'" ;;
esac

# A known verb with no file behind it is this repository mid-port, not a user
# error. Say which verb and which path, and exit 1 — a bare 127 from exec
# would be true but useless.
target="$LIBEXEC/$verb.sh"
if [ ! -f "$target" ]; then
  echo "falconet: verb '$verb' is not implemented yet (no $target)" >&2
  exit 1
fi
if [ ! -x "$target" ]; then
  echo "falconet: verb '$verb' is not executable ($target)" >&2
  exit 1
fi

exec "$target" "$@"
