#!/usr/bin/env bash
#
# config-probe — a stand-in caller for lib/config.sh and lib/handoff.sh.
#
# Those two are sourced libraries, not verbs, so there is no process to spawn
# at them directly. The probe is that process. It exists so the TEST never
# sources the thing it is testing (AGENTS.md: no test may reach inside its
# subject) — the assertions stay about stdout, exit codes and files, and the
# probe is the only piece a future port would have to rewrite.
#
#   FALCONET_ROOT=/path/to/repo config-probe file
#                                            get <jq-path>
#                                            array <jq-path>
#                                            handoff [explicit-dir]
#                                            env <KEY=value>
#
# An explicit --config path (the flag each verb parses for itself) is passed
# as $PROBE_CONFIG so the probe's own argument parsing stays out of the way.

set -uo pipefail

ROOT="${FALCONET_ROOT:?config-probe needs FALCONET_ROOT}"
. "$ROOT/lib/config.sh"
. "$ROOT/lib/handoff.sh"

config_init "${PROBE_CONFIG:-}"

case "${1:-}" in
  file)    printf '%s\n' "$FALCONET_CONFIG_FILE" ;;
  get)     config_get "$2" ;;
  array)   config_get_array "$2" ;;
  handoff) handoff_init "${2:-}"; printf '%s\n' "$HANDOFF" ;;
  env)     handoff_init ""; github_env_append "$2" ;;
  *)       echo "config-probe: unknown op '${1:-}'" >&2; exit 64 ;;
esac
